<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi">

  <!-- MoveIt's model of the LeKiwi: the combined robot from lekiwi_bringup plus the ground. Only
       move_group and the MoveIt RViz panel use this file; robot_state_publisher and ros2_control
       keep using lekiwi_bringup/urdf/lekiwi.urdf.xacro, and the joints are the same. -->
  <xacro:include filename="$(find lekiwi_bringup)/urdf/lekiwi.urdf.xacro"/>
  <xacro:include filename="$(find lekiwi_moveit_config)/config/ground.xacro"/>

  <xacro:lekiwi_ground/>

</robot>
